{
  "compilerOptions": {
    "esModuleInterop": true,
    "target": "ES2022",
    "module": "NodeNext",
    "noImplicitAny": true,
    "preserveConstEnums": true,
    "declaration": true,
    "strictNullChecks": true,
    "strict": true,
    "sourceMap": true,
    "types": ["node"],
    "moduleResolution": "NodeNext",
    "skipLibCheck": true
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules"]
}
