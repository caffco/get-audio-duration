{
  "name": "get-audio-duration",
  "description": "Get the duration of an audio file",
  "version": "5.1.0",
  "author": "Lluís Ulzurrun de Asanza Sàez <me@llu.is> (http://llu.is)",
  "license": "MIT",
  "repository": "caffco/get-audio-duration",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "music-metadata": "^12.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@types/node": "^24.2.0",
    "@types/tmp": "^0.2.6",
    "@vitest/browser-playwright": "5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "es-check": "^9.1.4",
    "git-conventional-commits": "^2.8.0",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "playwright": "1.65.1",
    "source-map-support": "^0.5.21",
    "tmp": "^0.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "lint:commit": "git-conventional-commits commit-msg-hook",
    "lint:source": "biome lint .",
    "lint:build": "es-check es2022 --module \"dist/**/*.js\" && es-check es2022 \"dist/**/*.cjs\"",
    "clean": "node scripts/clean.mjs",
    "build": "run-s clean build:compile lint:build",
    "build:compile": "tsc --project tsconfig.build.json",
    "test": "vitest --coverage --project node",
    "test:browser": "run-s build test:browser:dist",
    "test:browser:dist": "vitest --project browser",
    "test:types": "tsc --project test/types/tsconfig.json",
    "test:package": "run-s build test:package:dist",
    "test:package:dist": "run-s test:types && node --test test/package.test.mjs",
    "format": "biome format --write .",
    "prepublishOnly": "CI=1 run-s test test:package",
    "update:changelog": "git-conventional-commits changelog --file 'CHANGELOG.md'",
    "update:version": "TEMP_PACKAGE_JSON=$(mktemp) &&git-conventional-commits version 2>/dev/null | xargs -I{} jq --arg newVersion {} '.version = $newVersion' package.json > \"$TEMP_PACKAGE_JSON\" && rm package.json && mv \"$TEMP_PACKAGE_JSON\" package.json",
    "prepare": "husky"
  },
  "keywords": [
    "audio",
    "duration",
    "ffmpeg",
    "ffprobe",
    "typescript"
  ],
  "files": [
    "dist/**/*"
  ],
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
